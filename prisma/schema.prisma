generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Kullanici {
  id        String       @id @default(cuid())
  ad        String
  email     String       @unique
  telefon   String?      // Hazırlayan telefon numarası
  sifreHash String
  rol       KullaniciRol @default(SATIS)
  createdAt DateTime     @default(now())
  oturumlar Session[]
  teklifler Teklif[]
  siparisler Siparis[]   // Karşıt ilişki
}

model Session {
  token       String    @id @default(cuid())
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  kullaniciId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model Musteri {
  id            String   @id @default(cuid())
  ad            String   // Müşteri / Firma Unvanı
  yetkiliAdi    String?  // Müşteri Yetkilisi Adı Soyadı
  yetkiliTelefon String? // Müşteri Yetkilisi Telefonu
  yetkiliEmail  String?  // Müşteri Yetkilisi E-postası
  telefon       String?  // Şirket Santral Telefonu
  email         String?
  muhasebeEmail String?
  vergiNo       String?
  faturaAdresi  String?
  sevkAdresi    String?
  createdAt     DateTime @default(now())

  teklifler      Teklif[]
  cariHareketler CariHareket[]
  siparisler     Siparis[]
  projeler       Proje[]
  ziyaretler     Ziyaret[]
  yetkililer     MusteriYetkili[] // YENİ: Birden fazla müşteri yetkilisi
  isiHesaplari   IsiHesap[]       // Isı pompası hesapları
  klimaHesaplari KlimaHesap[]     // Klima / VRF hesapları
  havalandirmaHesaplari HavalandirmaHesap[] // Havalandırma hesapları
}

// YENİ: Müşteriye bağlı ek yetkililer (ana yetkili Musteri.yetkiliAdi alanında durmaya devam eder)
model MusteriYetkili {
  id        String   @id @default(cuid())
  musteriId String
  musteri   Musteri  @relation(fields: [musteriId], references: [id], onDelete: Cascade)
  ad        String
  unvan     String?
  telefon   String?
  email     String?
  createdAt DateTime @default(now())
  teklifler Teklif[]

  @@index([musteriId])
}

model Teklif {
  id                       String            @id @default(cuid())
  teklifNo                 Int               @unique @default(autoincrement())
  baslik                   String            @default("")
  musteri                  Musteri           @relation(fields: [musteriId], references: [id])
  musteriId                String
  muhatap                  String?           // Müşterisiz teklifte PDF'te müşteri adı yerine yazılan serbest metin
  // YENİ: MALİYET PDF VE EXCEL DOSYA ALANLARI
  maliyetPdf               Bytes?
  maliyetPdfAdi            String?
  maliyetPdfTipi           String?
  maliyetExcel             Bytes?
  maliyetExcelAdi          String?
  maliyetExcelTipi         String?
  takipNotu                String?           // YENİ: Satış Temsilcisinin Proje Takip Notu
  ihaleyiAlan              String?           // İhaleyi alan firma
  ekapNo                   String?           // Varsa Ekap No
  ipkbNo                   String?           // Varsa İpkb no
  projeId                  String?
  proje                    Proje?            @relation(fields: [projeId], references: [id])
  yetkiliId                String?           // YENİ: Teklifin muhatabı olan müşteri yetkilisi (boşsa ana yetkili)
  yetkili                  MusteriYetkili?   @relation(fields: [yetkiliId], references: [id], onDelete: SetNull)
  kopyaKaynakTeklifId      String?           // YENİ: Kopyalandığı teklifin ID'si (sadece panelde görünür)
  kopyaKaynakTeklifNo      Int?              // YENİ: Kopyalandığı teklifin numarası (kaynak silinse de görünsün)
  tarih                    DateTime          @default(now())
  ilkTarih                 DateTime          @default(now()) // YENİ: İlk Oluşturulma Tarihi
  durum                    TeklifDurum       @default(BEKLEMEDE)
  paraBirimi               String            @default("TRY")
  kdvOrani                 Float             @default(20)
  kdvDahil                 Boolean           @default(false)
  gecerlilikGunu           Int               @default(15)
  birimFiyatGoster         Boolean           @default(true)
  fiyatGizliBolumler       String?           // JSON dizi: PDF'te birim fiyatı / satır tutarı gizlenen bölüm adları (yalnız bölüm toplamı görünür)
  revizyonNo               Int               @default(1)
  olusturanKullaniciId     String?           // Hazırlayan Kullanıcı Bağlantısı
  olusturanKullanici       Kullanici?        @relation(fields: [olusturanKullaniciId], references: [id])
  olusturanAdi             String            @default("")
  kaynakSatinalmaTeklifiId String?
  kaynakSatinalmaTeklifi   SatinalmaTeklifi? @relation(fields: [kaynakSatinalmaTeklifiId], references: [id])
  kalemler                 TeklifKalem[]
  sablonlar                TeklifSablon[]    @relation("TeklifSablonSecimi")
  revizyonlar              TeklifRevizyon[]
  siparis                  Siparis?
  kesifler                 KesifFormu[]
  sozlesme                 Sozlesme?
  paylasim                 TeklifPaylasim?   // WhatsApp / müşteri linki
  gorusmeler               Ziyaret[]         // Bu teklifle ilgili görüşme notları
  // Red nedeni (teklif "Reddedildi" yapılırken sorulur)
  redNedeni                String?           // FIYAT | RAKIP | IPTAL | ERTELENDI | CEVAPSIZ | TEKNIK | DIGER
  redRakip                 String?           // İşi alan firma (biliniyorsa)
  redAciklama              String?
  redTarihi                DateTime?
  // Müşterinin teklif linkinden verdiği onay
  musteriOnayAdi           String?
  musteriOnayNotu          String?
  musteriOnayTarihi        DateTime?
  musteriOnayRevizyon      Int?              // Onaylandığı andaki revizyon no
  musteriOnayTutar         String?           // Onaylandığı andaki genel toplam (yazıyla: "64.000,00 $ + KDV")
  musteriOnayIp            String?
  // Bu teklife özel düzenlenmiş not metinleri: {"<notId>": "metin"} (hazır not değişmez)
  ozelNotlar               String?
  isiHesaplari             IsiHesap[]        // Bu teklife aktarılan ısı pompası hesapları
  klimaHesaplari           KlimaHesap[]      // Bu teklife aktarılan klima / VRF hesapları
  havalandirmaHesaplari    HavalandirmaHesap[] // Bu teklife aktarılan havalandırma hesapları
  // Arşiv (teklif silinmez): arşivlenen teklif listelerden düşer, "Arşiv" görünümünde ve kendi sayfasında durur
  arsivTarihi              DateTime?
  arsivleyenAdi            String?
}

// Teklifin müşteriye gönderilen gizli linki (iklimofisi.com/t/<anahtar>).
// Link iptal edilince satır silinir; yeniden oluşturulursa YENİ anahtar üretilir.
model TeklifPaylasim {
  id              String    @id @default(cuid())
  teklif          Teklif    @relation(fields: [teklifId], references: [id], onDelete: Cascade)
  teklifId        String    @unique
  anahtar         String    @unique
  olusturanAdi    String    @default("")
  createdAt       DateTime  @default(now())
  goruntulenme    Int       @default(0)
  sonGoruntulenme DateTime?
}

// Onaylanan tekliften hazırlanan, müşteriye imzalatılacak sözleşme taslağı.
// Kalemler ve maddeler oluşturulurken kopyalanır (JSON metni olarak saklanır);
// teklif sonradan değişse de sözleşme değişmez.
model Sozlesme {
  id               String   @id @default(cuid())
  teklif           Teklif   @relation(fields: [teklifId], references: [id], onDelete: Cascade)
  teklifId         String   @unique
  baslik           String   @default("SATIŞ VE MONTAJ SÖZLEŞMESİ")
  sozlesmeTarihi   DateTime @default(now())
  paraBirimi       String   @default("TRY") // Sözleşme bedelinin para birimi
  kur              Float    @default(1)     // Teklif para birimi → sözleşme para birimi
  kdvOrani         Float    @default(20)
  kdvDahil         Boolean  @default(false)
  birimFiyatGoster Boolean  @default(true)
  isverenUnvan     String
  isverenAdres     String?
  isverenVergi     String?
  isverenTelefon   String?
  isverenYetkili   String?
  isinKonusu       String
  isYeri           String?
  kalemler         String   // JSON: [{bolum, aciklama, adet, birimFiyat}] (teklif para biriminde)
  maddeler         String   // JSON: [{baslik, icerik}]
  durum            String   @default("TASLAK")
  olusturanAdi     String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TeklifKalem {
  id           String          @id @default(cuid())
  teklif       Teklif          @relation(fields: [teklifId], references: [id], onDelete: Cascade)
  teklifId     String
  bolum        String?         @default("Genel Kalemler")
  aciklama     String
  adet         Float           @default(1)
  birim        String          @default("Adet") // Ölçü birimi: Adet, m, m², m³, kg, Takım, Götürü… (lib/birimler.ts)
  birimFiyat   Float           @default(0)
  iskontoYuzde Float           @default(0)
  markaId      String?
  marka        Marka?          @relation(fields: [markaId], references: [id])
  sira         Int             @default(0) // Teklifteki sırası (formdaki sıra; 0'dan başlar)
  sevkiyatlar  SevkiyatKaydi[]
  teslimler    TeslimKaydi[]
}

model Marka {
  id       String        @id @default(cuid())
  ad       String        @unique
  logoAdi  String?
  logoTipi String?
  logo     Bytes?
  kalemler TeklifKalem[]
  urunler  Urun[]
}

model Urun {
  id                  String        @id @default(cuid())
  kod                 String?
  ad                  String
  markaId             String?
  marka               Marka?        @relation(fields: [markaId], references: [id])
  birim               String        @default("Adet")
  
  // MANUEL STOK VE MALİYET / GİDER ALANLARI
  stokMiktari         Float         @default(0)
  maliyetFiyati       Float         @default(0)
  ekGiderler          Float         @default(0)  // Nakliye / Gümrük ek gideri
  maliyetParaBirimi   String        @default("TRY")
  listeFiyati         Float         @default(0)
  paraBirimi          String        @default("TRY")
  hedefKarMarjiYuzde  Float         @default(20)
  depoKonumu          String?
  
  aciklama            String?
  createdAt           DateTime      @default(now())
  gorselId            String?       // Ürün fotoğrafı (Gorsel tablosu) — fiyat listelerinde kullanılır
  fiyatListesiKalemleri FiyatListesiKalem[]

  // STOK İLİŞKİLERİ
  stokHareketleri     StokHareket[]
  depoStoklar         DepoStok[]
  seriNolar           UrunSeriNo[]
  isiPompasiModelleri IsiPompasiModeli[]
  satinalmaSiparisKalemleri SatinalmaSiparisKalemi[]

  @@unique([kod])
}

// Yüklenen fotoğraflar (ürün ve fiyat listesi satırları). Tarayıcıda küçültülüp JPEG olarak gelir.
model Gorsel {
  id        String   @id @default(cuid())
  veri      Bytes
  tip       String   @default("image/jpeg")
  genislik  Int      @default(0)
  yukseklik Int      @default(0)
  boyut     Int      @default(0)
  createdAt DateTime @default(now())
}

// Müşterilere PDF olarak gönderilen fotoğraflı fiyat listeleri
model FiyatListesi {
  id               String              @id @default(cuid())
  baslik           String
  aciklama         String?
  paraBirimi       String              @default("TRY")
  kdvDahil         Boolean             @default(false)
  iskontoYuzde     Float               @default(0)
  iskontoKapsam    String              @default("HEPSI") // İki fiyatlı listede iskontonun uygulandığı sütun: HEPSI | FIYAT1 | FIYAT2
  alisIskontoYuzde  Float?             // Liste fiyatından alış iskontosu (alış fiyatı yalnız panelde görünür; boş = kullanılmıyor)
  satisIskontoYuzde Float?             // Doluysa 2. fiyat (satış) = 1. fiyat (liste) − bu iskonto, otomatik hesaplanır
  kartKarYuzde      Float?             // Doluysa 3. fiyat (ör. kredi kartı) = alış (liste − alış iskontosu) + bu kâr; fiyat3 bu satış fiyatını tutar
  yuvarlamaAdim    Int?                // Liste iskontosu uygulanan fiyatların (PDF) yuvarlanacağı adım: 1, 5, 10, 50, 100 (boş/0 = yok)
  fiyatGoster      Boolean             @default(true)
  duzen            String              @default("KART") // KART (3 sütun) | LISTE (satır satır) | TABLO (kompakt tablo)
  fiyatBaslik      String?             // İki fiyatlı listede birinci fiyat sütununun adı (ör. "Nakit")
  fiyat2Baslik     String?             // Doluysa liste iki fiyatlıdır; ikinci sütunun adı (ör. "Kart")
  fiyat3Baslik     String?             // Doluysa (iki fiyatlı listede) 3. fiyat sütunu; PDF'te 1. fiyatın yanında çıkar (ör. "Kredi Kartı 9 Taksit")
  kaynak           String?             // Otomatik güncellenen liste: "KAYA" (Kaya İklimlendirme). Boş = elle hazırlanan liste
  kaynakDurum      String?             // Otomatik güncelleme bilgisi (JSON: kaynak PDF, liste tarihi, son kontrol, değişiklik özeti, hata)
  gecerlilikTarihi DateTime?
  notlar           String?
  olusturanAdi     String              @default("")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  kalemler         FiyatListesiKalem[]
  paylasimlar      FiyatListesiPaylasim[]
}

// Müşteriye gönderilen fiyat listesi linki (iklimofisi.com/f/<anahtar>). Her alıcıya ayrı link.
// Link açıldığında listenin O ANKİ hâli gösterilir: panelde kaydedilen fiyat anında yansır.
// İptal edilen link silinmez (iptalTarihi dolar), artık açılmaz.
model FiyatListesiPaylasim {
  id              String       @id @default(cuid())
  liste           FiyatListesi @relation(fields: [listeId], references: [id], onDelete: Cascade)
  listeId         String
  anahtar         String       @unique
  alici           String       @default("")
  olusturanAdi    String       @default("")
  createdAt       DateTime     @default(now())
  goruntulenme    Int          @default(0)
  sonGoruntulenme DateTime?
  iptalTarihi     DateTime?
  iptalEdenAdi    String?
  haric           String? // bu linkte GÖSTERİLMEYEN ürünlerin seçim anahtarları (JSON dizi; boş = tüm ürünler)

  @@index([listeId])
}

model FiyatListesiKalem {
  id       String       @id @default(cuid())
  listeId  String
  liste    FiyatListesi @relation(fields: [listeId], references: [id], onDelete: Cascade)
  sira     Int          @default(0)
  bolum    String       @default("")
  urunId   String?      // Katalogdan eklendiyse (fotoğraf yoksa ürünün fotoğrafı kullanılır)
  urun     Urun?        @relation(fields: [urunId], references: [id], onDelete: SetNull)
  ad       String
  kod      String?
  marka    String?
  aciklama String?
  birim    String       @default("Adet")
  fiyat    Float        @default(0)
  fiyat2   Float?       // İki fiyatlı listede ikinci fiyat (ör. kart fiyatı); 0 / boş = fiyat sorunuz
  fiyat3   Float?       // 3. fiyat sütunu (ör. kredi kartı 9 taksit liste fiyatı); 0 / boş = fiyat sorunuz
  gorselId String?      // Bu satıra özel fotoğraf

  @@index([listeId])
}

model TeklifRevizyon {
  id         String   @id @default(cuid())
  teklif     Teklif   @relation(fields: [teklifId], references: [id], onDelete: Cascade)
  teklifId   String
  revizyonNo Int
  veriJson   String
  tarih      DateTime @default(now())
}

model CariHareket {
  id            String    @id @default(cuid())
  musteri       Musteri   @relation(fields: [musteriId], references: [id])
  musteriId     String
  tarih         DateTime  @default(now())
  aciklama      String
  tur           CariTur
  tutar         Float
  odemeYontemi  String?
  odemeDetay    String?
  vadeTarihi    DateTime? // Çek / Senet Vade Tarihi
  cekNo         String?   // Çek No
  banka         String?   // Banka Adı
  evrakDosya    Bytes?    // Fatura / Dekont / Çek Görseli veya PDF
  evrakDosyaAdi String?
  evrakDosyaTipi String?
  // İptal (finansal kayıt silinmez): iptal edilen hareket bakiyeye ve çek listelerine girmez, listede üstü çizili görünür
  iptalTarihi   DateTime?
  iptalEdenAdi  String?
  iptalNedeni   String?
  // Döviz bilgisi (tutar her zaman TL'dir): dövizli işlemde orijinal tutar ve kullanılan kur
  paraBirimi    String?
  dovizTutar    Float?
  kur           Float?
}

model TeklifSablon {
  id        String   @id @default(cuid())
  baslik    String   // Panelde görünen ad/kod, örn. "Ödeme Koşulları (Ç-9)"
  grupBaslik String? // Müşteriye giden başlık, örn. "Ödeme Koşulları"
  icerik    String
  sira      Int      @default(0)
  teklifler Teklif[] @relation("TeklifSablonSecimi")
}

model Siparis {
  id                String          @id @default(cuid())
  teklif            Teklif          @relation(fields: [teklifId], references: [id])
  teklifId          String          @unique
  musteri           Musteri         @relation(fields: [musteriId], references: [id])
  musteriId         String
  durum             SiparisDurum    @default(ONAY_BEKLIYOR)
  kur               Float           @default(1)
  ekNot             String          @default("")
  sevkAdresi        String?
  sozlesmeDosyaAdi  String?
  sozlesmeDosyaTipi String?
  sozlesmeDosya     Bytes?
  
  olusturanKullaniciId String?
  olusturanKullanici   Kullanici?   @relation(fields: [olusturanKullaniciId], references: [id])
  olusturanAdi         String       @default("")

  onaylayanAdi      String?
  onayTarihi        DateTime?
  redSebebi         String?
  faturaNo          String?
  faturaTarihi      DateTime?
  olusturmaTarihi   DateTime        @default(now())
  // Dondurulmuş tutar: sipariş açılınca ve onaylanınca teklifin o anki kalemleri, net tutarı ve revizyonu
  // buraya yazılır; teklif sonradan değişse de sipariş tutarı ve ciro raporu değişmez
  tutarNet          Float?          // KDV hariç, iskontolu toplam (teklif para biriminde)
  paraBirimi        String?
  teklifRevizyonNo  Int?
  kalemlerJson      String?         // [{bolum, aciklama, adet, birim, birimFiyat, iskontoYuzde}]
  // Sipariş silinmez: iptal edilince kim, ne zaman, neden kaydedilir
  iptalTarihi       DateTime?
  iptalEdenAdi      String?
  iptalNedeni       String?
  sevkiyatlar       SevkiyatKaydi[]
  teslimler         TeslimKaydi[]
  satinalmaSiparisleri SatinalmaSiparisi[] // bu satış siparişi için verilen tedarikçi siparişleri (gerçek maliyet)
}

model SevkiyatKaydi {
  id            String      @id @default(cuid())
  siparis       Siparis     @relation(fields: [siparisId], references: [id], onDelete: Cascade)
  siparisId     String
  teklifKalem   TeklifKalem @relation(fields: [teklifKalemId], references: [id])
  teklifKalemId String
  adet          Float       @default(1)
  not           String?
  tarih         DateTime    @default(now())
}

model TeslimKaydi {
  id            String      @id @default(cuid())
  siparis       Siparis     @relation(fields: [siparisId], references: [id], onDelete: Cascade)
  siparisId     String
  teklifKalem   TeklifKalem @relation(fields: [teklifKalemId], references: [id])
  teklifKalemId String
  adet          Float       @default(1)
  not           String?
  evrakAdi      String?
  evrakTipi     String?
  evrak         Bytes?
  tarih         DateTime    @default(now())
}

model Tedarikci {
  id        String             @id @default(cuid())
  ad        String
  telefon   String?
  vergiNo   String?
  adres     String?
  email     String?            // satınalma siparişinin e-postayla gönderileceği adres
  createdAt DateTime           @default(now())
  hareketler TedarikciHareket[]
  teklifler  SatinalmaTeklifi[]
  satinalmaSiparisleri SatinalmaSiparisi[]
}

model TedarikciHareket {
  id            String               @id @default(cuid())
  tedarikci     Tedarikci            @relation(fields: [tedarikciId], references: [id])
  tedarikciId   String
  tarih         DateTime             @default(now())
  aciklama      String
  tur           TedarikciHareketTuru
  tutar         Float
  vadeTarihi    DateTime? // Çek / Senet Vade Tarihi
  cekNo         String?   // Çek No
  banka         String?   // Banka Adı
  evrakDosya    Bytes?    // Fatura / Dekont / Çek Görseli veya PDF
  evrakDosyaAdi String?
  evrakDosyaTipi String?
  // İptal (finansal kayıt silinmez): iptal edilen hareket bakiyeye ve ödeme listelerine girmez, listede üstü çizili görünür
  iptalTarihi   DateTime?
  iptalEdenAdi  String?
  iptalNedeni   String?
  // Alış faturası eşleşmesi: fatura borcu hangi satınalma siparişine ait
  faturaNo            String?
  satinalmaSiparisiId String?
  satinalmaSiparisi   SatinalmaSiparisi? @relation(fields: [satinalmaSiparisiId], references: [id])
}

model SatinalmaTeklifi {
  id          String                  @id @default(cuid())
  tedarikci   Tedarikci               @relation(fields: [tedarikciId], references: [id])
  tedarikciId String
  baslik      String
  paraBirimi  String                  @default("TRY")
  tarih       DateTime                @default(now())
   // YENİ: MALİYET PDF VE EXCEL DOSYA ALANLARI
  maliyetPdf        Bytes?
  maliyetPdfAdi     String?
  maliyetPdfTipi    String?
  maliyetExcel      Bytes?
  maliyetExcelAdi   String?
  maliyetExcelTipi  String?
  toplamTutar Float?                  // Tedarikçi birim fiyat vermeyip sadece toplam verdiyse (boşsa kalemlerden hesaplanır)
  alisIskontoYuzde Float?             // Fiyatlar liste fiyatıysa bize özel alış iskontosu (%); net alış = liste × (1 − iskonto). Boş = yok
  kalemler    SatinalmaTeklifKalemi[]
  tekliflar   Teklif[]
  satinalmaSiparisleri SatinalmaSiparisi[]
}

model SatinalmaTeklifKalemi {
  id                 String           @id @default(cuid())
  satinalmaTeklifi   SatinalmaTeklifi @relation(fields: [satinalmaTeklifiId], references: [id], onDelete: Cascade)
  satinalmaTeklifiId String
  bolum              String?          // PDF'ten okunan teklifte ürün grubu (ör. "Heat-Pump Dış Üniteler"); müşteri teklifine bölüm olarak geçer
  aciklama           String
  adet               Float            @default(1)
  birimFiyat         Float
}

model KesifFormu {
  id                 String    @id @default(cuid())
  musteriAdi         String
  telefon            String?
  adres              String?
  alanM2             Float?
  mevcutSistem       String?
  notlar             String
  olusturanAdi       String    @default("")
  tarih              DateTime  @default(now())
  olusturulanTeklifId String?
  olusturulanTeklif   Teklif?  @relation(fields: [olusturulanTeklifId], references: [id])
}

model WebTalebi {
  id        String   @id @default(cuid())
  ad        String
  telefon   String?
  email     String?
  mesaj     String
  dosyaAdi  String?
  dosyaTipi String?
  dosya     Bytes?
  okundu    Boolean  @default(false)
  tarih     DateTime @default(now())
}

model Proje {
  id              String           @id @default(cuid())
  ad              String
  konum           String?
  musteriId       String?
  musteri         Musteri?         @relation(fields: [musteriId], references: [id])
  kaynak          String?
  ihaleDurumu     ProjeIhaleDurumu @default(TAKIPTE)
  ihaleyiAlan     String?
  tahminiDeger    Float?
  paraBirimi      String           @default("TRY")
  notlar          String?
  olusturanAdi    String           @default("")
  olusturmaTarihi DateTime         @default(now())
  teklifler       Teklif[]
  ziyaretler      Ziyaret[]
  satinalmaSiparisleri SatinalmaSiparisi[]
}

model Ziyaret {
  id               String    @id @default(cuid())
  musteriId        String?
  musteri          Musteri?  @relation(fields: [musteriId], references: [id])
  projeId          String?
  proje            Proje?    @relation(fields: [projeId], references: [id])
  tarih            DateTime  @default(now())
  not              String
  hatirlatmaTarihi DateTime?
  hatirlatmaNotu   String?
  hatirlatmaTamam  Boolean   @default(false)
  olusturanAdi     String    @default("")
  olusturanKullaniciId String? // Kaydı giren panel kullanıcısı (hatırlatma e-postası bu kişiye gider)
  tur              String    @default("ZIYARET") // ZIYARET | TELEFON | WHATSAPP | EPOSTA | DIGER
  teklifId         String?
  teklif           Teklif?   @relation(fields: [teklifId], references: [id], onDelete: SetNull)

  @@index([teklifId])
}

model SirketAyarlari {
  id           String   @id @default("default")
  unvan        String   @default("İklim Ofisi Mühendislik A.Ş.")
  slogan       String?  @default("İklimlendirme & VRF Sistem Çözümleri")
  adres        String?  @default("Atatürk Mah. Sanayi Cad. No:142/A, Ümraniye / İstanbul")
  telefon      String?  @default("+90 (216) 450 00 00")
  email        String?  @default("info@iklimofisi.com")
  web          String?  @default("www.iklimofisi.com")
  vergiDairesi String?
  vergiNo      String?
  whatsapp     String?  // Sitede görünen WhatsApp numarası (boşsa WhatsApp butonu çıkmaz)
  satinalmaOnayEsigi Float? // Satınalma siparişi onay eşiği (TL, KDV hariç). Altındaki siparişler kendiliğinden onaylanır; boşsa yöneticinin açtıkları dışında hepsi onay bekler
  updatedAt    DateTime @updatedAt
}

// Kim, ne zaman, hangi işlemi yaptı (panel işlem geçmişi).
// Kullanıcıya bağlı değildir: kullanıcı silinse bile geçmiş kaybolmaz.
model IslemKaydi {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  kullaniciId String?
  kullaniciAd String?
  islem       String
  hedefId     String?
  veri        String?

  @@index([createdAt])
  @@index([kullaniciId])
  @@index([hedefId])
}

// ---------------- STOK VE DEPO MODELLERİ ----------------

model StokHareket {
  id           String          @id @default(cuid())
  urun         Urun            @relation(fields: [urunId], references: [id], onDelete: Cascade)
  urunId       String
  tur          StokHareketTuru
  miktar       Float
  birimMaliyet Float           @default(0)
  aciklama     String
  referansNo   String?
  olusturanAdi String          @default("")
  tarih        DateTime        @default(now())
}

model Depo {
  id        String     @id @default(cuid())
  ad        String
  kod       String?    @unique
  adres     String?
  stoklar   DepoStok[]
}

model DepoStok {
  id             String @id @default(cuid())
  depo           Depo   @relation(fields: [depoId], references: [id], onDelete: Cascade)
  depoId         String
  urun           Urun   @relation(fields: [urunId], references: [id], onDelete: Cascade)
  urunId         String

  fizikselMiktar Float  @default(0)
  rezerveMiktar  Float  @default(0)
  
  @@unique([depoId, urunId])
}

model UrunSeriNo {
  id               String      @id @default(cuid())
  urun             Urun        @relation(fields: [urunId], references: [id], onDelete: Cascade)
  urunId           String
  seriNo           String      @unique
  depoId           String?
  durum            SeriNoDurum @default(DEPODA)
  musteriAdi       String?
  garantiBaslangic DateTime?
  tarih            DateTime    @default(now())
}

// ---------------- ENUM TANIMLARI ----------------

enum ProjeIhaleDurumu {
  TAKIPTE
  TEKLIF_VERILDI
  KAZANILDI
  KAYBEDILDI
  IPTAL
}

enum KullaniciRol {
  ADMIN
  SATIS
  SATINALMA // satış yetkileri; satınalma ekranlarının sorumlusu
  MUHASEBE  // satış yetkileri + finansal kayıt iptali ve ay kapanışı
  YATIRIMCI // yalnız görüntüler, hiçbir kaydı değiştiremez
}

enum TeklifDurum {
  BEKLEMEDE
  ONAYLANDI
  REDDEDILDI
}

enum CariTur {
  BORC
  ALACAK
}

enum SiparisDurum {
  ONAY_BEKLIYOR
  HAZIRLANIYOR
  KISMEN_SEVK_EDILDI
  SEVK_EDILDI
  KISMEN_TESLIM_EDILDI
  TESLIM_EDILDI
  FATURALANDI
  IPTAL
  REDDEDILDI
}

enum TedarikciHareketTuru {
  BORC
  ODEME
}

enum StokHareketTuru {
  GIRIS
  CIKIS
  DUZELTME
}

enum SeriNoDurum {
  DEPODA
  REZERVE
  SATILDI
  SERVISDE
}

// -----------------------------------------------------------------------------
// ISI POMPASI HESABI
// -----------------------------------------------------------------------------

// Hesapta model önerisi için ısı pompası kataloğu (kapasiteler kW)
model IsiPompasiModeli {
  id             String   @id @default(cuid())
  marka          String
  model          String
  kapA7W35       Float    @default(0) // A7/W35 ısıtma kapasitesi
  kapAm7W35      Float    @default(0) // A-7/W35
  kapAm7W55      Float    @default(0) // A-7/W55
  kapAm15W35     Float? // A-15/W35 (biliniyorsa)
  minDisSicaklik Float    @default(-20) // çalışma alt sınırı °C
  maksCikis      Float    @default(60) // en yüksek çıkış suyu °C
  yedekIsiticiKw Float    @default(0) // dahili elektrikli ısıtıcı
  urunId         String? // ürün kataloğundaki karşılığı (teklife fiyatıyla aktarılır)
  urun           Urun?    @relation(fields: [urunId], references: [id], onDelete: SetNull)
  aciklama       String?
  aktif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Kaydedilen ısı pompası / radyatör / yerden ısıtma hesabı (girdiler JSON metni)
model IsiHesap {
  id                   String   @id @default(cuid())
  ad                   String
  musteriId            String?
  musteri              Musteri? @relation(fields: [musteriId], references: [id], onDelete: SetNull)
  il                   String   @default("İstanbul")
  veri                 String   @default("{}")
  toplamKw             Float    @default(0)
  teklifId             String?
  teklif               Teklif?  @relation(fields: [teklifId], references: [id], onDelete: SetNull)
  olusturanKullaniciId String?
  olusturanAdi         String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([musteriId])
}

// Kaydedilen klima / multi split / VRF hesabı (girdiler JSON metni)
model KlimaHesap {
  id                   String   @id @default(cuid())
  ad                   String
  musteriId            String?
  musteri              Musteri? @relation(fields: [musteriId], references: [id], onDelete: SetNull)
  il                   String   @default("İstanbul")
  veri                 String   @default("{}")
  toplamKw             Float    @default(0) // toplam soğutma yükü
  teklifId             String?
  teklif               Teklif?  @relation(fields: [teklifId], references: [id], onDelete: SetNull)
  olusturanKullaniciId String?
  olusturanAdi         String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([musteriId])
}

// Havalandırma hesabı (girdiler JSON: mahaller, santraller, kanal mesafeleri)
model HavalandirmaHesap {
  id                   String   @id @default(cuid())
  ad                   String
  musteriId            String?
  musteri              Musteri? @relation(fields: [musteriId], references: [id], onDelete: SetNull)
  il                   String   @default("İstanbul")
  veri                 String   @default("{}")
  toplamDebi           Float    @default(0) // toplam besleme debisi, m³/h
  teklifId             String?
  teklif               Teklif?  @relation(fields: [teklifId], references: [id], onDelete: SetNull)
  olusturanKullaniciId String?
  olusturanAdi         String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([musteriId])
}

// NOTLAR & HATIRLATMALAR (panel)
// gizli = true → yalnız yazan kullanıcı görür. Hatırlatma maili seçilen gün sabah
// 08:00'de (otomatik görevle) gider; o gün 08:00 geçtiyse kaydedilir kaydedilmez gider.
model PanelNotu {
  id                   String    @id @default(cuid())
  baslik               String?
  icerik               String
  gizli                Boolean   @default(false)
  sabit                Boolean   @default(false) // listenin başında tutulur
  tamamlandi           Boolean   @default(false)
  olusturanId          String
  olusturanAdi         String    @default("")
  hatirlatmaGunu       String?   // YYYY-MM-DD (Türkiye saatiyle)
  hatirlatmaSaati      String?   // HH:MM (mailde ve listede yazar)
  hatirlatmaAlicilar   String?   // JSON: mail gidecek kullanıcı id listesi
  hatirlatmaGonderildi DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([olusturanId])
  @@index([hatirlatmaGunu])
}

// -----------------------------------------------------------------------------
// SATINALMA SİPARİŞİ (tedarikçiye verilen sipariş) — satınalma zinciri
// Tedarikçi teklifinden ya da elle açılır; tutar eşiği aşarsa yönetici onaylar.
// Mal kabul edildikçe kalemlerin teslim alınan miktarı artar (ürün koduyla eşleşen kalem stoğa girer),
// tedarikçinin alış faturası cari borç olarak bu siparişe bağlanır.
// Satış siparişine bağlıysa o siparişin gerçek maliyeti ve brüt kârı buradan hesaplanır.
// Kayıt silinmez: iptal edilir (kim, ne zaman, neden).
// -----------------------------------------------------------------------------
model SatinalmaSiparisi {
  id                   String                   @id @default(cuid())
  no                   Int                      @unique @default(autoincrement())
  tedarikci            Tedarikci                @relation(fields: [tedarikciId], references: [id])
  tedarikciId          String
  satinalmaTeklifi     SatinalmaTeklifi?        @relation(fields: [satinalmaTeklifiId], references: [id])
  satinalmaTeklifiId   String?
  siparis              Siparis?                 @relation(fields: [siparisId], references: [id])
  siparisId            String?
  proje                Proje?                   @relation(fields: [projeId], references: [id])
  projeId              String?
  baslik               String
  paraBirimi           String                   @default("TRY")
  kur                  Float                    @default(1)   // 1 birim = ? TL (sipariş açılırken)
  tutarNet             Float                    @default(0)   // KDV hariç, iskontolu toplam (sipariş para biriminde)
  durum                String                   @default("ONAY_BEKLIYOR") // ONAY_BEKLIYOR · ONAYLANDI · KISMEN_TESLIM · TESLIM_ALINDI · REDDEDILDI · IPTAL
  beklenenTeslimTarihi DateTime?
  notlar               String?
  olusturanAdi         String                   @default("")
  olusturmaTarihi      DateTime                 @default(now())
  onaylayanAdi         String?
  onayTarihi           DateTime?
  redNedeni            String?
  iptalTarihi          DateTime?
  iptalEdenAdi         String?
  iptalNedeni          String?
  // Tedarikçiye gönderim: PDF linki (WhatsApp için, tahmin edilemez anahtar) ve son gönderim bilgisi
  paylasimAnahtari     String?                  @unique
  sonGonderimTarihi    DateTime?
  sonGonderimKanali    String?                  // EPOSTA · WHATSAPP
  sonGonderimAlici     String?
  sonGonderenAdi       String?
  gonderimSayisi       Int                      @default(0)
  kalemler             SatinalmaSiparisKalemi[]
  malKabuller          MalKabul[]
  faturalar            TedarikciHareket[]

  @@index([tedarikciId])
  @@index([siparisId])
}

model SatinalmaSiparisKalemi {
  id                  String            @id @default(cuid())
  satinalmaSiparisi   SatinalmaSiparisi @relation(fields: [satinalmaSiparisiId], references: [id])
  satinalmaSiparisiId String
  sira                Int               @default(0)
  bolum               String?
  kod                 String?           // ürün kodu (stok kartıyla eşleşirse mal kabulde stoğa girer)
  urun                Urun?             @relation(fields: [urunId], references: [id])
  urunId              String?
  aciklama            String
  adet                Float
  birim               String            @default("Adet")
  birimFiyat          Float
  iskontoYuzde        Float             @default(0)
  malKabulKalemleri   MalKabulKalemi[]

  @@index([satinalmaSiparisiId])
}

model MalKabul {
  id                  String            @id @default(cuid())
  satinalmaSiparisi   SatinalmaSiparisi @relation(fields: [satinalmaSiparisiId], references: [id])
  satinalmaSiparisiId String
  tarih               DateTime          @default(now())
  irsaliyeNo          String?
  not                 String?
  olusturanAdi        String            @default("")
  olusturmaTarihi     DateTime          @default(now())
  iptalTarihi         DateTime?
  iptalEdenAdi        String?
  iptalNedeni         String?
  kalemler            MalKabulKalemi[]

  @@index([satinalmaSiparisiId])
}

model MalKabulKalemi {
  id         String                 @id @default(cuid())
  malKabul   MalKabul               @relation(fields: [malKabulId], references: [id])
  malKabulId String
  kalem      SatinalmaSiparisKalemi @relation(fields: [kalemId], references: [id])
  kalemId    String
  miktar     Float

  @@index([malKabulId])
  @@index([kalemId])
}

// -----------------------------------------------------------------------------
// AY KAPANIŞI (dönem kilidi)
// Kapatılan ayın tarihli finansal kayıtları (cari / tedarikçi hareketi, alış faturası) eklenemez,
// iptal edilemez; düzeltme açık aya ters kayıtla yapılır. Kapanış anındaki ay özeti saklanır.
// Yönetici, nedenini yazarak dönemi yeniden açabilir (kayıt tutulur).
// -----------------------------------------------------------------------------
model DonemKapanis {
  id            String    @id @default(cuid())
  donem         String    @unique // "2026-11"
  kapatanAdi    String
  kapanisTarihi DateTime  @default(now())
  ozetJson      String?   // kapanış anındaki ay özeti (yatırımcı raporu rakamları)
  acikMi        Boolean   @default(false) // yönetici yeniden açtıysa true
  acanAdi       String?
  acilisTarihi  DateTime?
  acilisNedeni  String?
}
