# Neon panelinde "Pooled connection" AÇIKKEN aldığın bağlantı dizesi (adında -pooler geçer)
# Uygulamanın günlük çalışması bunu kullanır.
DATABASE_URL="postgresql://kullanici:sifre@ep-xxx-pooler.bolge.aws.neon.tech/neondb?sslmode=require"

# Neon panelinde "Pooled connection" KAPATILINCA aldığın bağlantı dizesi (adında -pooler YOK)
# Sadece "npx prisma migrate dev" çalıştırırken kullanılır.
DIRECT_URL="postgresql://kullanici:sifre@ep-xxx.bolge.aws.neon.tech/neondb?sslmode=require"

# İlk kurulumda (npm run prisma:seed) otomatik oluşturulacak yönetici hesabı.
# Kurulumdan sonra panelden şifreni değiştiremiyorsan (henüz o özellik yok),
# Kullanıcılar sayfasından yeni bir yönetici ekleyip eski hesabı silebilirsin.
ADMIN_EMAIL="admin@iklimofisi.com"
ADMIN_SIFRE="degistir123"

# Satınalma → Gelen Teklifler sayfasındaki "PDF'den Teklif Yükle" özelliği
# için gerekli. console.anthropic.com adresinden ücretli bir hesap açıp
# API anahtarı oluşturman gerekiyor. Bu olmadan diğer her şey çalışır,
# sadece PDF'den otomatik ayıklama özelliği çalışmaz (elle giriş her zaman var).
ANTHROPIC_API_KEY="sk-ant-..."
